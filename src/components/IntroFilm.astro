---
// Cinematic portfolio opening film — an enhancement, not a loading dependency.
// The <head> gate runs synchronously; the video source is loaded only for new visitors.
const introVideo = 'https://res.cloudinary.com/dnzjg9lq8/video/upload/v1792540107/Untitled_video_2_yv8zqi.mp4';
---
<div
  class="intro-film"
  data-intro-film
  role="dialog"
  aria-modal="true"
  aria-label="Shajedul Kabir Rafi cinematic introduction"
>
  <div class="intro-film__ambient" aria-hidden="true"></div>

  <video
    class="intro-film__video"
    data-intro-video
    data-intro-src={introVideo}
    muted
    playsinline
    preload="none"
    disablepictureinpicture
    disableremoteplayback
    aria-label="Cinematic Shajedul Kabir Rafi logo reveal video"
  ></video>

  <div class="intro-film__fallback" aria-hidden="true">
    <span class="intro-film__fallback-monogram">R<span>.</span></span>
  </div>

  <div class="intro-film__topline" aria-hidden="true">
    <span>RAFI / PERSONAL PORTFOLIO</span>
    <span>THE OPENING FILM — 001</span>
  </div>

  <div class="intro-film__footer">
    <div class="intro-film__identity">
      <span class="intro-film__index">00 / IDENTITY</span>
      <strong>SHAJEDUL KABIR RAFI</strong>
      <span class="intro-film__status" data-intro-status aria-live="polite">PREPARING THE REVEAL</span>
    </div>

    <div class="intro-film__actions">
      <button class="intro-film__sound" type="button" data-intro-sound aria-label="Turn on video sound" aria-pressed="false">SOUND OFF <span aria-hidden="true">↗</span></button>
      <button class="intro-film__skip" type="button" data-intro-skip>
        SKIP INTRO <span aria-hidden="true">↗</span>
      </button>
    </div>
  </div>

  <div class="intro-film__progress" aria-hidden="true"><span data-intro-progress></span></div>
</div>
